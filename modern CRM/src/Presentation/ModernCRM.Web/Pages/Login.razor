@page "/login"
@layout EmptyLayout
@inject AuthApiClient AuthApi
@inject AuthStateProvider AuthState
@inject NavigationManager Nav
@inject ISnackbar Snackbar

<PageTitle>Login — TestCRM</PageTitle>

<style>
    .login-bg {
        min-height: 100vh;
        background: radial-gradient(ellipse at 20% 50%, rgba(124,58,237,0.15) 0%, transparent 60%),
                    radial-gradient(ellipse at 80% 20%, rgba(6,182,212,0.10) 0%, transparent 55%),
                    #0d1117;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .login-card {
        width: 100%;
        max-width: 420px;
        background: rgba(22, 27, 39, 0.85) !important;
        border: 1px solid rgba(124,58,237,0.25) !important;
        border-radius: 20px !important;
        box-shadow: 0 32px 80px rgba(0,0,0,0.6), 0 0 0 1px rgba(255,255,255,0.04) !important;
        backdrop-filter: blur(20px);
        padding: 48px 40px !important;
    }

    .login-logo-ring {
        width: 64px;
        height: 64px;
        border-radius: 18px;
        background: linear-gradient(135deg, rgba(124,58,237,0.3) 0%, rgba(6,182,212,0.2) 100%);
        border: 1px solid rgba(124,58,237,0.4);
        display: flex;
        align-items: center;
        justify-content: center;
        box-shadow: 0 8px 24px rgba(124,58,237,0.35);
    }

    .login-title {
        font-size: 26px !important;
        font-weight: 800 !important;
        letter-spacing: -0.03em !important;
        background: linear-gradient(135deg, #e2e8f0 0%, #a78bfa 100%);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
    }

    .login-btn {
        height: 50px !important;
        border-radius: 12px !important;
        font-size: 15px !important;
        font-weight: 700 !important;
        letter-spacing: 0.03em !important;
        background: linear-gradient(135deg, #7c3aed 0%, #6d28d9 100%) !important;
        box-shadow: 0 8px 24px rgba(124,58,237,0.45) !important;
        transition: all 0.2s !important;
    }

    .login-btn:hover:not([disabled]) {
        box-shadow: 0 12px 32px rgba(124,58,237,0.65) !important;
        transform: translateY(-1px);
    }

    .login-btn[disabled] {
        opacity: 0.5 !important;
        box-shadow: none !important;
    }

    .login-divider {
        border-color: rgba(255,255,255,0.07) !important;
    }
</style>

<div class="login-bg">
    <MudPaper Class="login-card" Elevation="0">

        @* Logo & heading *@
        <MudStack AlignItems="AlignItems.Center" Spacing="2" Class="mb-6">
            <div class="login-logo-ring">
                <MudIcon Icon="@Icons.Material.Rounded.Hub" Size="Size.Large" Color="Color.Primary" />
            </div>
            <MudText Class="login-title">ModernCRM</MudText>
            <MudText Typo="Typo.body2" Style="opacity:.45; font-size:13px;">
                Sign in to continue to your workspace
            </MudText>
        </MudStack>

        <MudDivider Class="login-divider mb-6" />

        @* Form *@
        <MudForm @ref="_form" @bind-IsValid="_isValid">
            <MudStack Spacing="3">
                <MudTextField @bind-Value="_model.TenantId"
                              Label="Tenant" Variant="Variant.Outlined"
                              Required="true" RequiredError="Tenant is required"
                              MaxLength="100" Validation="@(new Func<string, string>(FormValidation.Slug))"
                              Adornment="Adornment.Start"
                              AdornmentIcon="@Icons.Material.Rounded.Domain" />

                <MudTextField @bind-Value="_model.Username"
                              Label="Username" Variant="Variant.Outlined"
                              Required="true" RequiredError="Username is required"
                              MaxLength="100" Validation="@(new Func<string, string>(FormValidation.Username))"
                              Adornment="Adornment.Start"
                              AdornmentIcon="@Icons.Material.Rounded.Person" />

                <MudTextField @bind-Value="_model.Password"
                              Label="Password" Variant="Variant.Outlined"
                              InputType="@_pwdType"
                              Required="true" RequiredError="Password is required"
                              MaxLength="128"
                              Adornment="Adornment.End"
                              AdornmentIcon="@_pwdIcon"
                              OnAdornmentClick="TogglePassword" />
            </MudStack>

            <MudButton Class="login-btn mt-5" Variant="Variant.Filled" Color="Color.Primary"
                       FullWidth="true" Disabled="!_isValid || _loading"
                       OnClick="LoginAsync">
                @if (_loading)
                {
                    <MudProgressCircular Size="Size.Small" Indeterminate="true" Color="Color.Inherit" />
                    <span class="ml-2">Signing in…</span>
                }
                else
                {
                    <span>Sign In</span>
                }
            </MudButton>
        </MudForm>

    </MudPaper>
</div>

@code {
    [Parameter, SupplyParameterFromQuery] public string? ReturnUrl { get; set; }

    private MudForm? _form;
    private bool _isValid;
    private bool _loading;

    private InputType _pwdType  = InputType.Password;
    private string   _pwdIcon   = Icons.Material.Rounded.VisibilityOff;

    private readonly LoginModel _model = new();

    private class LoginModel
    {
        public string TenantId { get; set; } = "default";
        public string Username { get; set; } = "";
        public string Password { get; set; } = "";
    }

    private void TogglePassword()
    {
        if (_pwdType == InputType.Password)
        {
            _pwdType = InputType.Text;
            _pwdIcon = Icons.Material.Rounded.Visibility;
        }
        else
        {
            _pwdType = InputType.Password;
            _pwdIcon = Icons.Material.Rounded.VisibilityOff;
        }
    }

    private async Task LoginAsync()
    {
        _loading = true;
        try
        {
            var res = await AuthApi.LoginAsync(
                new LoginRequest(_model.TenantId, _model.Username, _model.Password));

            if (res is null)
            {
                Snackbar.Add("Invalid credentials.", Severity.Error);
                return;
            }

            await AuthState.SignInAsync(res.AccessToken, res.TenantId, res.ApiUrl);
            Snackbar.Add($"Welcome, {res.Username}!", Severity.Success);
            Nav.NavigateTo(string.IsNullOrEmpty(ReturnUrl) ? "/dashboard" : ReturnUrl, true);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Login failed: {ex.Message}", Severity.Error);
        }
        finally
        {
            _loading = false;
        }
    }
}

