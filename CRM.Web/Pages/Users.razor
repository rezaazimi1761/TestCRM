@page "/users"
@attribute [Authorize]
@inject CrmApiClient Crm
@inject ISnackbar Snackbar
@inject IDialogService DialogService

<PageTitle>Users</PageTitle>

<MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-4">
    <MudIcon Icon="@Icons.Material.Filled.People" Size="Size.Large" Color="Color.Primary" />
    <MudText Typo="Typo.h4">Users</MudText>
    <MudSpacer />
    <MudButton Variant="Variant.Filled" Color="Color.Primary"
               StartIcon="@Icons.Material.Filled.PersonAdd" OnClick="@(() => OpenDialogAsync(null))">
        New User
    </MudButton>
    <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Refresh"
               OnClick="Refresh" Class="ml-2">Refresh</MudButton>
</MudStack>

<MudTable Items="_items" Hover="true" Striped="true" Dense="true" Loading="_loading">
    <HeaderContent>
        <MudTh>Name</MudTh>
        <MudTh>Email</MudTh>
        <MudTh>Role</MudTh>
        <MudTh>Active</MudTh>
        <MudTh>Actions</MudTh>
    </HeaderContent>
    <RowTemplate>
        <MudTd>@context.FirstName @context.LastName</MudTd>
        <MudTd>@context.Email</MudTd>
        <MudTd><MudChip Size="Size.Small" Color="Color.Primary">@context.Role</MudChip></MudTd>
        <MudTd>
            <MudIcon Icon="@(context.IsActive ? Icons.Material.Filled.CheckCircle : Icons.Material.Filled.Cancel)"
                     Color="@(context.IsActive ? Color.Success : Color.Error)" />
        </MudTd>
        <MudTd>
            <MudIconButton Icon="@Icons.Material.Filled.Edit" Color="Color.Primary" Size="Size.Small"
                           OnClick="@(() => OpenDialogAsync(context))" />
            <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error" Size="Size.Small"
                           OnClick="@(() => DeleteAsync(context.Id))" />
        </MudTd>
    </RowTemplate>
</MudTable>

@code {
    private List<AppUser> _items = new();
    private bool _loading;

    public class AppUser
    {
        public int     Id        { get; set; }
        public string? FirstName { get; set; }
        public string? LastName  { get; set; }
        public string? Email     { get; set; }
        public string? Role      { get; set; }
        public bool    IsActive  { get; set; }
    }

    protected override Task OnInitializedAsync() => Refresh();

    private async Task Refresh()
    {
        _loading = true;
        try { _items = await Crm.GetListAsync<AppUser>("/api/users") ?? new(); }
        catch (Exception ex) { Snackbar.Add($"Load failed: {ex.Message}", Severity.Error); }
        finally { _loading = false; }
    }

    private async Task OpenDialogAsync(AppUser? existing)
    {
        var model = existing is null ? null : new UserDialog.Model
        {
            Id        = existing.Id,
            FirstName = existing.FirstName ?? "",
            LastName  = existing.LastName  ?? "",
            Email     = existing.Email     ?? "",
            Role      = existing.Role,
            IsActive  = existing.IsActive
        };

        var parameters = new DialogParameters { ["Existing"] = model };
        var dlg = await DialogService.ShowAsync<UserDialog>(existing is null ? "New User" : "Edit User", parameters);
        var res = await dlg.Result;
        if (res is null || res.Canceled) return;

        var req = (UserDialog.Model)res.Data!;
        HttpResponseMessage r;
        if (req.Id == 0)
            r = await Crm.PostAsync("/api/users", new
            {
                firstName = req.FirstName, lastName = req.LastName,
                email = req.Email, password = req.Password, role = req.Role
            });
        else
            r = await Crm.PutAsync($"/api/users/{req.Id}", new
            {
                id = req.Id,
                firstName = req.FirstName, lastName = req.LastName,
                email = req.Email, role = req.Role, isActive = req.IsActive
            });

        Snackbar.Add(r.IsSuccessStatusCode
            ? (req.Id == 0 ? "User created" : "User updated")
            : $"Failed: {await r.Content.ReadAsStringAsync()}",
            r.IsSuccessStatusCode ? Severity.Success : Severity.Error);
        if (r.IsSuccessStatusCode) await Refresh();
    }

    private async Task DeleteAsync(int id)
    {
        var ok = await DialogService.ShowMessageBox("Delete user?", "This action cannot be undone.",
                                                    yesText: "Delete", cancelText: "Cancel");
        if (ok != true) return;
        var r = await Crm.DeleteAsync($"/api/users/{id}");
        Snackbar.Add(r.IsSuccessStatusCode ? "Deleted" : "Failed",
                     r.IsSuccessStatusCode ? Severity.Success : Severity.Error);
        await Refresh();
    }
}
