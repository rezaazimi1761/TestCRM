@page "/users"
@attribute [Authorize]
@inject CrmApiClient Crm
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject AuthenticationStateProvider AuthStateProvider

<PageTitle>Users</PageTitle>

<MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-3">
    <MudIcon Icon="@Icons.Material.Rounded.Group" Size="Size.Large" Color="Color.Primary" />
    <MudText Typo="Typo.h4">Users</MudText>
    <MudSpacer />
    <MudTextField @bind-Value="_search" Placeholder="Search name, email…"
                  Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search"
                  Immediate="true" DebounceInterval="350"
                  OnDebounceIntervalElapsed="OnSearchChanged"
                  Variant="Variant.Outlined" Margin="Margin.Dense"
                  Style="min-width:220px" />
    <MudSelect T="string" Value="_roleFilter" Placeholder="All Roles"
               Variant="Variant.Outlined" Margin="Margin.Dense" Clearable="true"
               Style="min-width:140px" Class="ml-2"
               ValueChanged="@((string? v) => { _roleFilter = v; _ = OnSearchChanged(); })">
        @foreach (var r in new[]{"User","Admin","SuperUser"})
        { <MudSelectItem Value="@r">@r</MudSelectItem> }
    </MudSelect>
    <MudButton Variant="Variant.Filled" Color="Color.Primary"
               StartIcon="@Icons.Material.Rounded.PersonAdd"
               OnClick="@(() => OpenDialogAsync(null))" Class="ml-2">
        New User
    </MudButton>
</MudStack>

<MudDataGrid T="AppUser" @ref="_grid" ServerData="LoadServerData"
             Hover="true" Dense="true" Striped="true" SortMode="SortMode.Single" Filterable="false">
    <Columns>
        <TemplateColumn Title="Name" SortBy="@(new Func<AppUser,object?>(x => x.FirstName))">
            <CellTemplate>
                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                    <MudAvatar Color="Color.Primary" Size="Size.Small"
                               Style="font-size:11px;font-weight:700;width:28px;height:28px;">
                        @(context.Item.FirstName?.Substring(0, 1).ToUpper())
                    </MudAvatar>
                    <span>@context.Item.FirstName @context.Item.LastName</span>
                </MudStack>
            </CellTemplate>
        </TemplateColumn>
        <PropertyColumn Property="x => x.Email" Title="Email" />
        <TemplateColumn Title="Role" SortBy="@(new Func<AppUser,object?>(x => x.Role))">
            <CellTemplate>
                <MudChip Size="Size.Small"
                         Color="@(context.Item.Role == "SuperUser" ? Color.Error : context.Item.Role == "Admin" ? Color.Warning : Color.Primary)">
                    @context.Item.Role
                </MudChip>
            </CellTemplate>
        </TemplateColumn>
        <TemplateColumn Title="Active" Sortable="false">
            <CellTemplate>
                <MudIcon Icon="@(context.Item.IsActive ? Icons.Material.Rounded.CheckCircle : Icons.Material.Rounded.Cancel)"
                         Color="@(context.Item.IsActive ? Color.Success : Color.Error)" Size="Size.Small" />
            </CellTemplate>
        </TemplateColumn>
        <TemplateColumn Title="Auth Sync" SortBy="@(new Func<AppUser,object?>(x => x.AuthSyncStatus))">
            <CellTemplate>
                @{
                    var (icon, color, tip) = context.Item.AuthSyncStatus switch
                    {
                        "Synced"  => (Icons.Material.Rounded.CheckCircle,  Color.Success, "Auth account ready"),
                        "Failed"  => (Icons.Material.Rounded.ErrorOutline, Color.Error,   "Auth sync failed — user deleted"),
                        _         => (Icons.Material.Rounded.HourglassTop, Color.Warning, "Waiting for AuthService…")
                    };
                }
                <MudTooltip Text="@tip">
                    <MudIcon Icon="@icon" Color="@color" Size="Size.Small" />
                </MudTooltip>
            </CellTemplate>
        </TemplateColumn>
        <TemplateColumn Title="Actions" Sortable="false">
            <CellTemplate>
                <MudIconButton Icon="@Icons.Material.Rounded.Edit" Color="Color.Primary" Size="Size.Small"
                               OnClick="@(() => OpenDialogAsync(context.Item))" />
                <MudIconButton Icon="@Icons.Material.Rounded.Delete" Color="Color.Error" Size="Size.Small"
                               OnClick="@(() => DeleteAsync(context.Item.Id))" />
            </CellTemplate>
        </TemplateColumn>
    </Columns>
    <PagerContent>
        <MudDataGridPager T="AppUser" PageSizeOptions="new[]{10,20,50,100}" />
    </PagerContent>
</MudDataGrid>

@code {
    private MudDataGrid<AppUser>? _grid;
    private string? _search;
    private string? _roleFilter;
    public class AppUser
    {
        public int     Id             { get; set; }
        public string? Username       { get; set; }
        public string? FirstName      { get; set; }
        public string? LastName       { get; set; }
        public string? Email          { get; set; }
        public string? Role           { get; set; }
        public bool    IsActive       { get; set; }
        public string  AuthSyncStatus { get; set; } = "Pending";
    }

    private async Task<GridData<AppUser>> LoadServerData(GridState<AppUser> state)
    {
        var sort = state.SortDefinitions.FirstOrDefault();
        try
        {
            var result = await Crm.GetPagedAsync<AppUser>(
                "/api/users", state.Page + 1, state.PageSize,
                sort?.SortBy?.ToLowerInvariant(), sort?.Descending ?? false, _search,
                new Dictionary<string, string?> { ["role"] = _roleFilter });
            return new GridData<AppUser> { Items = result?.Items ?? new(), TotalItems = result?.TotalCount ?? 0 };
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Load failed: {ex.Message}", Severity.Error);



            return new GridData<AppUser> { Items = new List<AppUser>(), TotalItems = 0 };



        }
    }

    private Task OnSearchChanged() => _grid?.ReloadServerData() ?? Task.CompletedTask;

    private async Task OpenDialogAsync(AppUser? existing)
    {
        var model = existing is null ? null : new UserDialog.Model
        {
            Id = existing.Id, Username = existing.Username ?? "", FirstName = existing.FirstName ?? "",
            LastName = existing.LastName ?? "", Email = existing.Email ?? "",
            Role = existing.Role ?? "User", IsActive = existing.IsActive
        };
        var authState   = await AuthStateProvider.GetAuthenticationStateAsync();
        var isSuperUser = authState.User.IsInRole("SuperUser");
        var parameters  = new DialogParameters { ["Existing"] = model, ["CallerIsSuperUser"] = isSuperUser };
        var dlg = await DialogService.ShowAsync<UserDialog>(existing is null ? "New User" : "Edit User", parameters);
        var res = await dlg.Result;
        if (res is null || res.Canceled) return;

        var req = (UserDialog.Model)res.Data!;
        if (req.Id == 0) await CreateUserAsync(req);
        else             await UpdateUserAsync(req);
    }

    private async Task CreateUserAsync(UserDialog.Model req)
    {
        // Single API call — TestCRM saves the user and publishes UserCreatedEvent
        // via the EF Core Outbox. AuthService receives the event and creates
        // the auth account asynchronously (guaranteed by Outbox + Inbox pattern).
        var r = await Crm.PostAsync("/api/users", new
        {
            username  = req.Username,
            firstName = req.FirstName,
            lastName  = req.LastName,
            email     = req.Email,
            password  = req.Password,
            role      = req.Role
        });

        Snackbar.Add(r.IsSuccessStatusCode
            ? "User created ✓ — auth account will be ready in seconds"
            : $"Failed: {await ApiErrorReader.ReadAsync(r)}",
            r.IsSuccessStatusCode ? Severity.Success : Severity.Error);

        if (r.IsSuccessStatusCode)
            await (_grid?.ReloadServerData() ?? Task.CompletedTask);
    }

    private async Task UpdateUserAsync(UserDialog.Model req)
    {
        var r = await Crm.PutAsync($"/api/users/{req.Id}", new
        {
            id = req.Id, firstName = req.FirstName, lastName = req.LastName,
            email = req.Email, role = req.Role, isActive = req.IsActive
        });
        Snackbar.Add(r.IsSuccessStatusCode ? "User updated ✓" : $"Update failed: {await ApiErrorReader.ReadAsync(r)}",
            r.IsSuccessStatusCode ? Severity.Success : Severity.Error);
        if (r.IsSuccessStatusCode) await (_grid?.ReloadServerData() ?? Task.CompletedTask);
    }

    private async Task DeleteAsync(int id)
    {
        var ok = await DialogService.ShowMessageBox("Delete user?",
            "This removes the user from CRM. Auth account must be removed separately.",
            yesText: "Delete", cancelText: "Cancel");
        if (ok != true) return;
        var r = await Crm.DeleteAsync($"/api/users/{id}");
        Snackbar.Add(r.IsSuccessStatusCode ? "Deleted from CRM" : "Failed",
                     r.IsSuccessStatusCode ? Severity.Success : Severity.Error);
        if (r.IsSuccessStatusCode) await (_grid?.ReloadServerData() ?? Task.CompletedTask);
    }
}
