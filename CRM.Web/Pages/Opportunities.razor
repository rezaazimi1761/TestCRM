@page "/opportunities"
@attribute [Authorize]
@inject CrmApiClient Crm
@inject ISnackbar Snackbar
@inject IDialogService DialogService

<PageTitle>Opportunities</PageTitle>

<MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-3">
    <MudIcon Icon="@Icons.Material.Filled.TrendingUp" Size="Size.Large" Color="Color.Primary" />
    <MudText Typo="Typo.h4">Opportunities</MudText>
    <MudSpacer />
    <MudTextField @bind-Value="_search" Placeholder="Search title, account…"
                  Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search"
                  Immediate="true" DebounceInterval="350"
                  OnDebounceIntervalElapsed="OnSearchChanged"
                  Variant="Variant.Outlined" Margin="Margin.Dense"
                  Style="min-width:240px" />
    <MudSelect T="string" Value="_stageFilter" Placeholder="All Stages"
               Variant="Variant.Outlined" Margin="Margin.Dense" Clearable="true"
               Style="min-width:170px" Class="ml-2"
               ValueChanged="@((string? v) => { _stageFilter = v; _ = OnSearchChanged(); })">
        @foreach (var s in new[]{"Prospecting","Qualification","Proposal","Negotiation","ClosedWon","ClosedLost"})
        { <MudSelectItem Value="@s">@s</MudSelectItem> }
    </MudSelect>
    <MudButton Variant="Variant.Filled" Color="Color.Primary"
               StartIcon="@Icons.Material.Filled.Add" OnClick="@(() => OpenDialogAsync(null))" Class="ml-2">
        New Opportunity
    </MudButton>
</MudStack>

<MudDataGrid T="Opportunity" @ref="_grid" ServerData="LoadServerData"
             Hover="true" Dense="true" Striped="true" SortMode="SortMode.Single" Filterable="false">
    <Columns>
        <PropertyColumn Property="x => x.Title"             Title="Title" />
        <TemplateColumn Title="Value" SortBy="@(new Func<Opportunity,object?>(x => x.Value))">
            <CellTemplate><b>@context.Item.Value.ToString("C")</b></CellTemplate>
        </TemplateColumn>
        <TemplateColumn Title="Stage" SortBy="@(new Func<Opportunity,object?>(x => x.Stage))">
            <CellTemplate>
                <MudChip Size="Size.Small" Color="@StageColor(context.Item.Stage)">@context.Item.Stage</MudChip>
            </CellTemplate>
        </TemplateColumn>
        <PropertyColumn Property="x => x.AccountName"       Title="Account"    Sortable="false" />
        <PropertyColumn Property="x => x.ExpectedCloseDate" Title="Close Date" Format="yyyy-MM-dd" />
        <TemplateColumn Title="Actions" Sortable="false">
            <CellTemplate>
                <MudIconButton Icon="@Icons.Material.Filled.Edit" Color="Color.Primary" Size="Size.Small"
                               OnClick="@(() => OpenDialogAsync(context.Item))" />
                <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error" Size="Size.Small"
                               OnClick="@(() => DeleteAsync(context.Item.Id))" />
            </CellTemplate>
        </TemplateColumn>
    </Columns>
    <PagerContent>
        <MudDataGridPager T="Opportunity" PageSizeOptions="new[]{10,20,50,100}" />
    </PagerContent>
</MudDataGrid>

@code {
    private MudDataGrid<Opportunity>? _grid;
    private string? _search;
    private string? _stageFilter;

    public class Opportunity
    {
        public int       Id                { get; set; }
        public string?   Title             { get; set; }
        public decimal   Value             { get; set; }
        public string?   Stage             { get; set; }
        public int?      AccountId         { get; set; }
        public string?   AccountName       { get; set; }
        public int?      ContactId         { get; set; }
        public string?   ContactName       { get; set; }
        public int?      AssignedToUserId  { get; set; }
        public DateTime? ExpectedCloseDate { get; set; }
        public string?   Notes             { get; set; }
    }

    private async Task<GridData<Opportunity>> LoadServerData(GridState<Opportunity> state)
    {
        var sort = state.SortDefinitions.FirstOrDefault();
        try
        {
            var result = await Crm.GetPagedAsync<Opportunity>(
                "/api/opportunities", state.Page + 1, state.PageSize,
                sort?.SortBy?.ToLowerInvariant(), sort?.Descending ?? false, _search,
                new Dictionary<string, string?> { ["stage"] = _stageFilter });
            return new GridData<Opportunity> { Items = result?.Items ?? new(), TotalItems = result?.TotalCount ?? 0 };
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Load failed: {ex.Message}", Severity.Error);



            return new GridData<Opportunity> { Items = new List<Opportunity>(), TotalItems = 0 };



        }
    }

    private Task OnSearchChanged() => _grid?.ReloadServerData() ?? Task.CompletedTask;

    private static Color StageColor(string? s) => s switch
    {
        "ClosedWon"     => Color.Success,
        "ClosedLost"    => Color.Error,
        "Negotiation"   => Color.Warning,
        "Proposal"      => Color.Info,
        "Qualification" => Color.Secondary,
        _               => Color.Default
    };

    private async Task OpenDialogAsync(Opportunity? existing)
    {
        var model = existing is null ? null : new OpportunityDialog.Model
        {
            Id = existing.Id, Title = existing.Title ?? "", Value = existing.Value,
            Stage = existing.Stage ?? "Prospecting", ExpectedCloseDate = existing.ExpectedCloseDate, Notes = existing.Notes
        };
        var parameters = new DialogParameters { ["Existing"] = model };
        var dlg = await DialogService.ShowAsync<OpportunityDialog>(existing is null ? "New Opportunity" : "Edit Opportunity", parameters);
        var res = await dlg.Result;
        if (res is null || res.Canceled) return;

        var req = (OpportunityDialog.Model)res.Data!;
        HttpResponseMessage r;
        if (req.Id == 0)
            r = await Crm.PostAsync("/api/opportunities", new { title = req.Title, value = req.Value, stage = req.Stage, expectedCloseDate = req.ExpectedCloseDate, notes = req.Notes });
        else
            r = await Crm.PutAsync($"/api/opportunities/{req.Id}", new { id = req.Id, title = req.Title, value = req.Value, stage = req.Stage, expectedCloseDate = req.ExpectedCloseDate, notes = req.Notes });

        Snackbar.Add(r.IsSuccessStatusCode ? (req.Id == 0 ? "Opportunity created" : "Opportunity updated") : $"Failed: {await r.Content.ReadAsStringAsync()}",
            r.IsSuccessStatusCode ? Severity.Success : Severity.Error);
        if (r.IsSuccessStatusCode) await (_grid?.ReloadServerData() ?? Task.CompletedTask);
    }

    private async Task DeleteAsync(int id)
    {
        var ok = await DialogService.ShowMessageBox("Delete opportunity?", "This action cannot be undone.", yesText: "Delete", cancelText: "Cancel");
        if (ok != true) return;
        var r = await Crm.DeleteAsync($"/api/opportunities/{id}");
        Snackbar.Add(r.IsSuccessStatusCode ? "Deleted" : "Failed", r.IsSuccessStatusCode ? Severity.Success : Severity.Error);
        if (r.IsSuccessStatusCode) await (_grid?.ReloadServerData() ?? Task.CompletedTask);
    }
}
