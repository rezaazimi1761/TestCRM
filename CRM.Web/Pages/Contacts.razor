@page "/contacts"
@attribute [Authorize]
@inject CrmApiClient Crm
@inject ISnackbar Snackbar
@inject IDialogService DialogService

<PageTitle>Contacts</PageTitle>

<MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-4">
    <MudIcon Icon="@Icons.Material.Filled.Contacts" Size="Size.Large" Color="Color.Primary" />
    <MudText Typo="Typo.h4">Contacts</MudText>
    <MudSpacer />
    <MudButton Variant="Variant.Filled" Color="Color.Primary"
               StartIcon="@Icons.Material.Filled.Add" OnClick="@(() => OpenDialogAsync(null))">
        New Contact
    </MudButton>
    <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Refresh"
               OnClick="Refresh" Class="ml-2">Refresh</MudButton>
</MudStack>

<MudTable Items="_items" Hover="true" Dense="true" Striped="true" Loading="_loading">
    <HeaderContent>
        <MudTh>First Name</MudTh>
        <MudTh>Last Name</MudTh>
        <MudTh>Email</MudTh>
        <MudTh>Phone</MudTh>
        <MudTh>Company</MudTh>
        <MudTh>Actions</MudTh>
    </HeaderContent>
    <RowTemplate>
        <MudTd>@context.FirstName</MudTd>
        <MudTd>@context.LastName</MudTd>
        <MudTd>@context.Email</MudTd>
        <MudTd>@context.Phone</MudTd>
        <MudTd>@context.Company</MudTd>
        <MudTd>
            <MudIconButton Icon="@Icons.Material.Filled.Edit" Color="Color.Primary" Size="Size.Small"
                           OnClick="@(() => OpenDialogAsync(context))" />
            <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error" Size="Size.Small"
                           OnClick="@(() => DeleteAsync(context.Id))" />
        </MudTd>
    </RowTemplate>
</MudTable>

@code {
    private List<Contact> _items = new();
    private bool _loading;

    public class Contact
    {
        public int     Id       { get; set; }
        public string? FirstName { get; set; }
        public string? LastName  { get; set; }
        public string? Email     { get; set; }
        public string? Phone     { get; set; }
        public string? Company   { get; set; }
        public string? JobTitle  { get; set; }
        public string? Notes     { get; set; }
    }

    protected override Task OnInitializedAsync() => Refresh();

    private async Task Refresh()
    {
        _loading = true;
        try { _items = await Crm.GetListAsync<Contact>("/api/contacts") ?? new(); }
        catch (Exception ex) { Snackbar.Add($"Load failed: {ex.Message}", Severity.Error); }
        finally { _loading = false; }
    }

    private async Task OpenDialogAsync(Contact? existing)
    {
        var model = existing is null ? null : new ContactDialog.Model
        {
            Id        = existing.Id,
            FirstName = existing.FirstName ?? "",
            LastName  = existing.LastName  ?? "",
            Email     = existing.Email     ?? "",
            Phone     = existing.Phone,
            Company   = existing.Company,
            JobTitle  = existing.JobTitle,
            Notes     = existing.Notes
        };

        var parameters = new DialogParameters { ["Existing"] = model };
        var dlg = await DialogService.ShowAsync<ContactDialog>(existing is null ? "New Contact" : "Edit Contact", parameters);
        var res = await dlg.Result;
        if (res is null || res.Canceled) return;

        var req = (ContactDialog.Model)res.Data!;
        HttpResponseMessage r;
        if (req.Id == 0)
            r = await Crm.PostAsync("/api/contacts", new
            {
                firstName = req.FirstName, lastName = req.LastName, email = req.Email,
                phone = req.Phone, company = req.Company, jobTitle = req.JobTitle, notes = req.Notes
            });
        else
            r = await Crm.PutAsync($"/api/contacts/{req.Id}", new
            {
                id = req.Id,
                firstName = req.FirstName, lastName = req.LastName, email = req.Email,
                phone = req.Phone, company = req.Company, jobTitle = req.JobTitle, notes = req.Notes
            });

        Snackbar.Add(r.IsSuccessStatusCode
            ? (req.Id == 0 ? "Contact created" : "Contact updated")
            : $"Failed: {await r.Content.ReadAsStringAsync()}",
            r.IsSuccessStatusCode ? Severity.Success : Severity.Error);
        if (r.IsSuccessStatusCode) await Refresh();
    }

    private async Task DeleteAsync(int id)
    {
        var ok = await DialogService.ShowMessageBox("Delete contact?", "This action cannot be undone.",
                                                    yesText: "Delete", cancelText: "Cancel");
        if (ok != true) return;
        var res = await Crm.DeleteAsync($"/api/contacts/{id}");
        Snackbar.Add(res.IsSuccessStatusCode ? "Deleted" : "Failed",
                     res.IsSuccessStatusCode ? Severity.Success : Severity.Error);
        await Refresh();
    }
}
