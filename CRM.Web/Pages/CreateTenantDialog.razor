@namespace CRM.Web.Pages

<MudDialog>
    <DialogContent>
        <MudForm @ref="_form" @bind-IsValid="_isValid">
            <MudTextField @bind-Value="_model.Slug"
                          Label="Slug" Variant="Variant.Outlined" Required="true"
                          HelperText="lowercase, e.g. 'acme'"
                          Disabled="@(_model.Id != 0)" />

            <MudTextField @bind-Value="_model.DisplayName" Class="mt-3"
                          Label="Display Name" Variant="Variant.Outlined" Required="true" />

            <MudSelect T="Guid" @bind-Value="_model.ServiceInstanceId" Class="mt-3"
                       Label="Service Instance" Variant="Variant.Outlined" Required="true">
                @foreach (var i in Instances)
                {
                    <MudSelectItem Value="@i.Id">@i.Name (@i.ApiUrl)</MudSelectItem>
                }
            </MudSelect>

            <MudTextField @bind-Value="_model.Description" Class="mt-3"
                          Label="Description" Variant="Variant.Outlined"
                          Lines="2" />

            @if (_model.Id != 0)
            {
                <MudCheckBox @bind-Value="_model.IsActive" Label="Active"
                             Color="Color.Primary" Class="mt-2" />
            }
        </MudForm>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">Cancel</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled"
                   Disabled="!_isValid" OnClick="Submit">@_submitLabel</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private MudDialogInstance Dialog { get; set; } = default!;
    [Parameter] public List<Tenants.ServiceInstanceDto> Instances { get; set; } = new();
    [Parameter] public Model? Existing { get; set; }

    private MudForm? _form;
    private bool _isValid;
    private Model _model = new();
    private string _submitLabel = "Create";

    public class Model
    {
        public int    Id                { get; set; }
        public string Slug              { get; set; } = "";
        public string DisplayName       { get; set; } = "";
        public Guid   ServiceInstanceId { get; set; }
        public string? Description      { get; set; }
        public bool   IsActive          { get; set; } = true;
    }

    protected override void OnParametersSet()
    {
        if (Existing is not null)
        {
            _model = new Model
            {
                Id                = Existing.Id,
                Slug              = Existing.Slug,
                DisplayName       = Existing.DisplayName,
                ServiceInstanceId = Existing.ServiceInstanceId,
                Description       = Existing.Description,
                IsActive          = Existing.IsActive
            };
            _submitLabel = "Save";
        }
    }

    private void Submit() => Dialog.Close(DialogResult.Ok(_model));
    private void Cancel() => Dialog.Cancel();
}
