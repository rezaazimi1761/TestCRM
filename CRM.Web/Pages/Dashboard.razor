@page "/dashboard"
@attribute [Authorize]
@inject AuthStateProvider AuthState
@inject CrmApiClient Crm
@using CRM.Web.Services

<PageTitle>Dashboard — TestCRM</PageTitle>

@* ── Section title ── *@
<MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-5">
    <MudIcon Icon="@Icons.Material.Rounded.Dashboard" Size="Size.Large" Color="Color.Primary" />
    <MudText Typo="Typo.h4" Style="font-weight:700;">Dashboard</MudText>
</MudStack>

@* ── KPI stat cards ── *@
<MudGrid Spacing="3">
    <MudItem xs="12" sm="6" md="2">
        <StatCard Title="Contacts"      Icon="@Icons.Material.Rounded.Contacts"          Color="Color.Primary" Value="@_contacts" />
    </MudItem>
    <MudItem xs="12" sm="6" md="2">
        <StatCard Title="Accounts"      Icon="@Icons.Material.Rounded.Business"           Color="Color.Info"    Value="@_accounts" />
    </MudItem>
    <MudItem xs="12" sm="6" md="2">
        <StatCard Title="Leads"         Icon="@Icons.Material.Rounded.PersonSearch"       Color="Color.Warning" Value="@_leads" />
    </MudItem>
    <MudItem xs="12" sm="6" md="2">
        <StatCard Title="Opportunities" Icon="@Icons.Material.Rounded.TrendingUp"         Color="Color.Success" Value="@_opps" />
    </MudItem>
    <MudItem xs="12" sm="6" md="2">
        <StatCard Title="Tickets"       Icon="@Icons.Material.Rounded.ConfirmationNumber" Color="Color.Secondary" Value="@_tickets.Count" />
    </MudItem>
    <MudItem xs="12" sm="6" md="2">
        <StatCard Title="Open Tickets"  Icon="@Icons.Material.Rounded.BugReport"          Color="Color.Error"   Value="@_openCount" />
    </MudItem>
</MudGrid>

@* ── Charts row ── *@
<MudGrid Spacing="3" Class="mt-4">

    @* Donut — Status *@
    <MudItem xs="12" md="4">
        <MudPaper Elevation="3" Class="pa-4" Style="border-radius:14px; height:100%;">
            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1" Class="mb-3">
                <MudIcon Icon="@Icons.Material.Rounded.DonutLarge" Color="Color.Secondary" Size="Size.Small" />
                <MudText Typo="Typo.subtitle1" Style="font-weight:600;">Tickets by Status</MudText>
            </MudStack>

            @if (_statusData.Any(v => v > 0))
            {
                <MudChart ChartType="ChartType.Donut"
                          InputData="@_statusData"
                          InputLabels="@_statusLabels"
                          Width="100%" Height="260px"
                          ChartOptions="@_donutOptions" />
            }
            else
            {
                <MudStack AlignItems="AlignItems.Center" Justify="Justify.Center" Style="height:260px;">
                    <MudIcon Icon="@Icons.Material.Rounded.Inbox" Size="Size.Large" Style="opacity:.25;" />
                    <MudText Typo="Typo.body2" Style="opacity:.4;">No ticket data</MudText>
                </MudStack>
            }

            @* Legend *@
            @if (_statusData.Length == _statusLabels.Length)
            {
                <MudStack Row="true" Justify="Justify.Center" Spacing="2" Class="mt-2" Style="flex-wrap:wrap;">
                    @for (int i = 0; i < _statusLabels.Length; i++)
                    {
                        var idx = i;
                        <MudChip Size="Size.Small" Style="@($"background:{_statusColors[idx]}22; color:{_statusColors[idx]}; border:1px solid {_statusColors[idx]}55; font-size:11px;")">
                            @_statusLabels[idx] (@((int)_statusData[idx]))
                        </MudChip>
                    }
                </MudStack>
            }
        </MudPaper>
    </MudItem>

    @* Donut — Priority *@
    <MudItem xs="12" md="4">
        <MudPaper Elevation="3" Class="pa-4" Style="border-radius:14px; height:100%;">
            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1" Class="mb-3">
                <MudIcon Icon="@Icons.Material.Rounded.PriorityHigh" Color="Color.Warning" Size="Size.Small" />
                <MudText Typo="Typo.subtitle1" Style="font-weight:600;">Tickets by Priority</MudText>
            </MudStack>

            @if (_priorityData.Any(v => v > 0))
            {
                <MudChart ChartType="ChartType.Donut"
                          InputData="@_priorityData"
                          InputLabels="@_priorityLabels"
                          Width="100%" Height="260px"
                          ChartOptions="@_donutOptions" />
            }
            else
            {
                <MudStack AlignItems="AlignItems.Center" Justify="Justify.Center" Style="height:260px;">
                    <MudIcon Icon="@Icons.Material.Rounded.Inbox" Size="Size.Large" Style="opacity:.25;" />
                    <MudText Typo="Typo.body2" Style="opacity:.4;">No ticket data</MudText>
                </MudStack>
            }

            @* Legend *@
            @if (_priorityData.Length == _priorityLabels.Length)
            {
                <MudStack Row="true" Justify="Justify.Center" Spacing="2" Class="mt-2" Style="flex-wrap:wrap;">
                    @for (int i = 0; i < _priorityLabels.Length; i++)
                    {
                        var idx = i;
                        <MudChip Size="Size.Small" Style="@($"background:{_priorityColors[idx]}22; color:{_priorityColors[idx]}; border:1px solid {_priorityColors[idx]}55; font-size:11px;")">
                            @_priorityLabels[idx] (@((int)_priorityData[idx]))
                        </MudChip>
                    }
                </MudStack>
            }
        </MudPaper>
    </MudItem>

    @* Due-date Timeline *@
    <MudItem xs="12" md="4">
        <MudPaper Elevation="3" Class="pa-4" Style="border-radius:14px; height:100%; overflow-y:auto; max-height:420px;">
            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1" Class="mb-3">
                <MudIcon Icon="@Icons.Material.Rounded.CalendarMonth" Color="Color.Info" Size="Size.Small" />
                <MudText Typo="Typo.subtitle1" Style="font-weight:600;">Upcoming Due Dates</MudText>
            </MudStack>

            @if (_upcomingTickets.Any())
            {
                <MudTimeline TimelinePosition="TimelinePosition.Start">
                    @foreach (var t in _upcomingTickets)
                    {
                        var overdue  = t.DueDate < DateTime.Today;
                        var today    = t.DueDate?.Date == DateTime.Today;
                        var dotColor = overdue ? Color.Error : today ? Color.Warning : Color.Info;

                        <MudTimelineItem Color="@dotColor" Size="Size.Small">
                            <ItemContent>
                                <MudPaper Elevation="0"
                                          Style="background:rgba(255,255,255,0.04); border-radius:8px; padding:8px 12px; margin-bottom:4px;">
                                    <MudText Typo="Typo.body2" Style="font-weight:600; line-height:1.3;">
                                        @t.Subject
                                    </MudText>
                                    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1" Class="mt-1" Style="flex-wrap:wrap; gap:4px;">
                                        <MudChip Size="Size.Small"
                                                 Style="@($"height:18px; font-size:10px; background:{PriorityHex(t.Priority)}22; color:{PriorityHex(t.Priority)};")">
                                            @t.Priority
                                        </MudChip>
                                        @if (t.AccountName is not null)
                                        {
                                            <MudText Typo="Typo.caption" Style="opacity:.55;">@t.AccountName</MudText>
                                        }
                                        <MudSpacer />
                                        <MudText Typo="Typo.caption"
                                                 Style="@($"font-weight:600; color:{(overdue ? "#f44336" : today ? "#ff9800" : "#90caf9")}")">
                                            @(overdue ? "Overdue · " : today ? "Today · " : "")@t.DueDate?.ToString("MMM d")
                                        </MudText>
                                    </MudStack>
                                </MudPaper>
                            </ItemContent>
                        </MudTimelineItem>
                    }
                </MudTimeline>
            }
            else
            {
                <MudStack AlignItems="AlignItems.Center" Justify="Justify.Center" Style="height:300px;">
                    <MudIcon Icon="@Icons.Material.Rounded.EventAvailable" Size="Size.Large" Style="opacity:.25;" />
                    <MudText Typo="Typo.body2" Style="opacity:.4;">No upcoming due dates</MudText>
                </MudStack>
            }
        </MudPaper>
    </MudItem>

</MudGrid>

@* ── Instance info pill ── *@
<MudPaper Elevation="0" Class="mt-5 pa-3"
          Style="border-radius:10px; border:1px solid rgba(255,255,255,0.07); display:inline-flex; align-items:center; gap:8px;">
    <MudIcon Icon="@Icons.Material.Rounded.Dns" Size="Size.Small" Color="Color.Secondary" />
    <MudText Typo="Typo.caption" Style="opacity:.6;">
        Connected instance: <b style="opacity:.9;">@_instanceUrl</b>
    </MudText>
</MudPaper>

@code {
    // ── KPI ──────────────────────────────────────────────────────
    private string _instanceUrl = "";
    private int _contacts, _accounts, _leads, _opps;

    // ── Ticket data ──────────────────────────────────────────────
    private List<TicketSummary> _tickets = new();
    private int _openCount;

    // ── Status chart ─────────────────────────────────────────────
    private double[] _statusData   = new double[4];   // same length as labels — avoids IndexOutOfRange on first render
    private string[] _statusLabels = { "New", "Active", "Closed", "Removed" };
    private string[] _statusColors = { "#42a5f5", "#66bb6a", "#78909c", "#ef5350" };

    // ── Priority chart ───────────────────────────────────────────
    private double[] _priorityData   = new double[4]; // same length as labels
    private string[] _priorityLabels = { "Low", "Medium", "High", "Critical" };
    private string[] _priorityColors = { "#78909c", "#42a5f5", "#ffa726", "#ef5350" };

    // ── Timeline ─────────────────────────────────────────────────
    private List<TicketSummary> _upcomingTickets = new();

    // ── Chart options ────────────────────────────────────────────
    private readonly ChartOptions _donutOptions = new()
    {
        ChartPalette = new[] { "#42a5f5", "#66bb6a", "#78909c", "#ef5350",
                               "#ffa726", "#ab47bc", "#26c6da", "#d4e157" }
    };

    // ── DTO ──────────────────────────────────────────────────────
    private class TicketSummary
    {
        public int      Id          { get; set; }
        public string   Subject     { get; set; } = "";
        public string   Status      { get; set; } = "New";
        public string   Priority    { get; set; } = "Medium";
        public string?  AccountName { get; set; }
        public DateTime? DueDate    { get; set; }
    }

    protected override async Task OnInitializedAsync()
    {
        _instanceUrl = await AuthState.GetApiUrlAsync() ?? "(unknown)";

        var contactsTask = Crm.GetPagedAsync<object>("/api/contacts", 1, 1);
        var accountsTask = Crm.GetPagedAsync<object>("/api/accounts", 1, 1);
        var leadsTask    = Crm.GetPagedAsync<object>("/api/leads",    1, 1);
        var oppsTask     = Crm.GetPagedAsync<object>("/api/opportunities", 1, 1);
        var ticketsTask  = Crm.GetPagedAsync<TicketSummary>("/api/tickets", 1, 1000);

        await Task.WhenAll(contactsTask, accountsTask, leadsTask, oppsTask, ticketsTask);

        _contacts = contactsTask.Result?.TotalCount ?? 0;
        _accounts = accountsTask.Result?.TotalCount ?? 0;
        _leads    = leadsTask.Result?.TotalCount    ?? 0;
        _opps     = oppsTask.Result?.TotalCount     ?? 0;
        _tickets  = ticketsTask.Result?.Items       ?? new();

        BuildCharts();
    }

    private void BuildCharts()
    {
        // ── Status donut ──────────────────────────────────────────
        _statusData = new double[]
        {
            _tickets.Count(t => t.Status == "New"),
            _tickets.Count(t => t.Status == "Active"),
            _tickets.Count(t => t.Status == "Closed"),
            _tickets.Count(t => t.Status == "Removed")
        };

        _openCount = _tickets.Count(t => t.Status is "New" or "Active");

        // ── Priority donut ────────────────────────────────────────
        _priorityData = new double[]
        {
            _tickets.Count(t => t.Priority == "Low"),
            _tickets.Count(t => t.Priority == "Medium"),
            _tickets.Count(t => t.Priority == "High"),
            _tickets.Count(t => t.Priority == "Critical")
        };

        // ── Timeline — tickets with due date, sorted asc, non-Removed ──
        _upcomingTickets = _tickets
            .Where(t => t.DueDate.HasValue && t.Status != "Removed" && t.Status != "Closed")
            .OrderBy(t => t.DueDate)
            .Take(15)
            .ToList();
    }

    private static string PriorityHex(string? p) => p switch
    {
        "Critical" => "#ef5350",
        "High"     => "#ffa726",
        "Low"      => "#78909c",
        _          => "#42a5f5"
    };
}
