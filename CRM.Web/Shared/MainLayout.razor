@inherits LayoutComponentBase
@inject NavigationManager Nav
@inject AuthStateProvider AuthState

<PageTitle>TestCRM</PageTitle>

<MudThemeProvider IsDarkMode="true" />
<MudDialogProvider FullWidth="true" MaxWidth="MaxWidth.Small" CloseButton="true" />
<MudSnackbarProvider />

<MudLayout>
    <AuthorizeView>
        <Authorized>
            <MudAppBar Elevation="1" Dense="false">
                <MudIconButton Icon="@Icons.Material.Rounded.Menu" Color="Color.Inherit"
                               Edge="Edge.Start" OnClick="@(_ => _drawerOpen = !_drawerOpen)" />
                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1" Class="ml-1">
                    <MudIcon Icon="@Icons.Material.Rounded.Hub" Color="Color.Primary" />
                    <MudText Typo="Typo.h6" Style="font-weight:700;">TestCRM</MudText>
                </MudStack>
                <MudSpacer />
                <MudChip T="string" Variant="Variant.Outlined" Color="Color.Secondary"
                         Size="Size.Small" Icon="@Icons.Material.Rounded.Domain" Class="mr-2">
                    @context.User.FindFirst("tenant_id")?.Value
                </MudChip>
                <MudAvatar Color="Color.Primary" Size="Size.Small"
                           Style="font-size:12px; font-weight:700; margin-right:6px;">
                    @(context.User.Identity?.Name?.Substring(0,1).ToUpper())
                </MudAvatar>
                <MudText Style="font-size:13px; opacity:.75; margin-right:4px;">
                    @context.User.Identity?.Name
                </MudText>
                <MudTooltip Text="Sign out">
                    <MudIconButton Icon="@Icons.Material.Rounded.Logout" Color="Color.Inherit"
                                   OnClick="LogoutAsync" Size="Size.Small" />
                </MudTooltip>
            </MudAppBar>

            <MudDrawer @bind-Open="_drawerOpen" ClipMode="DrawerClipMode.Always" Elevation="2"
                       Variant="DrawerVariant.Persistent">
                <MudDrawerHeader Style="padding: 16px;">
                    <MudText Typo="Typo.overline"
                             Style="letter-spacing:2px; font-size:10px; opacity:.4;">
                        MENU
                    </MudText>
                </MudDrawerHeader>

                <MudNavMenu>
                    <MudNavLink Href="/dashboard"     Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Rounded.Dashboard">Dashboard</MudNavLink>
                    <MudNavLink Href="/contacts"      Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Rounded.Contacts">Contacts</MudNavLink>
                    <MudNavLink Href="/accounts"      Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Rounded.Business">Accounts</MudNavLink>
                    <MudNavLink Href="/leads"         Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Rounded.PersonSearch">Leads</MudNavLink>
                    <MudNavLink Href="/opportunities" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Rounded.TrendingUp">Opportunities</MudNavLink>
                    <MudNavLink Href="/activities"    Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Rounded.EventNote">Activities</MudNavLink>
                    <MudNavLink Href="/users"         Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Rounded.Group">Users</MudNavLink>

                    @if (context.User.IsInRole("SuperUser"))
                    {
                        <MudDivider Class="my-2" />
                        <MudText Typo="Typo.overline" Class="px-4"
                                 Style="font-size:10px; letter-spacing:2px; opacity:.4;">
                            ADMIN
                        </MudText>
                        <MudNavLink Href="/tenants"           Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Rounded.Domain">Tenants</MudNavLink>
                        <MudNavLink Href="/service-instances" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Rounded.Dns">Service Instances</MudNavLink>
                    }
                </MudNavMenu>
            </MudDrawer>
        </Authorized>
    </AuthorizeView>

    <MudMainContent>
        <MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="my-6">
            @Body
        </MudContainer>
    </MudMainContent>
</MudLayout>

@code {
    private bool _drawerOpen = true;

    private async Task LogoutAsync()
    {
        await AuthState.SignOutAsync();
        Nav.NavigateTo("/login", true);
    }
}
