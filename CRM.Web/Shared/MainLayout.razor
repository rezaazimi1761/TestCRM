@inherits LayoutComponentBase
@inject NavigationManager Nav
@inject AuthStateProvider AuthState

<PageTitle>TestCRM</PageTitle>

<MudThemeProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<MudLayout>
    <AuthorizeView>
        <Authorized>
            <MudAppBar Elevation="1" Color="Color.Primary">
                <MudIconButton Icon="@Icons.Material.Filled.Menu" Color="Color.Inherit"
                               Edge="Edge.Start" OnClick="@(_ => _drawerOpen = !_drawerOpen)" />
                <MudText Typo="Typo.h6" Class="ml-3">TestCRM</MudText>
                <MudSpacer />
                <MudChip Color="Color.Secondary" Size="Size.Small">
                    @context.User.FindFirst("tenant_id")?.Value
                </MudChip>
                <MudText Class="mx-3">@context.User.Identity?.Name</MudText>
                <MudIconButton Icon="@Icons.Material.Filled.Logout" Color="Color.Inherit"
                               OnClick="LogoutAsync" />
            </MudAppBar>

            <MudDrawer @bind-Open="_drawerOpen" ClipMode="DrawerClipMode.Always" Elevation="2">
                <MudNavMenu>
                    <MudNavLink Href="/dashboard" Icon="@Icons.Material.Filled.Dashboard">Dashboard</MudNavLink>
                    <MudNavLink Href="/contacts" Icon="@Icons.Material.Filled.Contacts">Contacts</MudNavLink>
                    <MudNavLink Href="/accounts" Icon="@Icons.Material.Filled.Business">Accounts</MudNavLink>
                    <MudNavLink Href="/leads" Icon="@Icons.Material.Filled.PersonAdd">Leads</MudNavLink>
                    <MudNavLink Href="/opportunities" Icon="@Icons.Material.Filled.MonetizationOn">Opportunities</MudNavLink>
                    <MudNavLink Href="/activities" Icon="@Icons.Material.Filled.Event">Activities</MudNavLink>
                    <MudNavLink Href="/users" Icon="@Icons.Material.Filled.People">Users</MudNavLink>

                    @if (context.User.IsInRole("SuperUser"))
                    {
                        <MudDivider Class="my-2" />
                        <MudText Typo="Typo.overline" Class="px-4">Administration</MudText>
                        <MudNavLink Href="/tenants" Icon="@Icons.Material.Filled.Domain">Tenants</MudNavLink>
                        <MudNavLink Href="/service-instances" Icon="@Icons.Material.Filled.Dns">Service Instances</MudNavLink>
                    }
                </MudNavMenu>
            </MudDrawer>
        </Authorized>
    </AuthorizeView>

    <MudMainContent>
        <MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="my-6">
            @Body
        </MudContainer>
    </MudMainContent>
</MudLayout>

@code {
    private bool _drawerOpen = true;

    private async Task LogoutAsync()
    {
        await AuthState.SignOutAsync();
        Nav.NavigateTo("/login", true);
    }
}
